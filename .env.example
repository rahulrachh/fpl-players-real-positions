# Every environment variable the project reads. All are optional: the values
# below are the defaults. Copy to `.env` for local overrides (never commit .env).
# The backend reads the process environment only; to load this file use
# `uv run --env-file ../.env ...` from backend/. Vite reads it automatically.

# --- Backend: database -------------------------------------------------------
# SQLite file. Relative paths resolve against backend/, never use an absolute
# machine path here.
DATABASE_PATH=data/fpl.db
# Web app only: open the file with immutable=1. Safe only when nothing writes
# the file while the app runs. Keep false locally; on Vercel api/index.py
# sets it to true.
DATABASE_IMMUTABLE=false

# --- Backend: official FPL API (public, no login) ----------------------------
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
# TTL of the in-memory cache for live FPL calls, in seconds.
FPL_CACHE_TTL_SECONDS=60
# TTL of a team's cached gameweek once FPL has checked its points (the data
# never changes after that), in seconds. Unfinished gameweeks use the TTL above.
FPL_FINISHED_CACHE_TTL_SECONDS=86400

# --- Backend: positions source (offline sync scripts only) -------------------
# api.sofascore.com answers 403; use the www host.
SOFASCORE_API_BASE_URL=https://www.sofascore.com/api/v1
# Polite minimum delay between requests to Sofascore, in seconds.
SOFASCORE_REQUEST_DELAY_SECONDS=2.5
# Retries for 429 / 5xx / network errors, waiting BACKOFF * 2^attempt seconds.
# A 403 (blocked) is never retried.
SOFASCORE_MAX_RETRIES=3
SOFASCORE_BACKOFF_SECONDS=5

# --- Backend: position logic -------------------------------------------------
# A stored match gives a dot only if its average is built from at least this
# many on-ball actions (Sofascore pointsCount); else an earlier match is used.
POSITION_MIN_POINTS_COUNT=1
# Double gameweek: two linked dots only when the matches are on opposite
# flanks, each more than this far from the center line (0-100 pitch width).
DGW_FLANK_MARGIN=10

# --- Backend: logging --------------------------------------------------------
LOG_LEVEL=INFO

# --- Frontend (Vite dev server) ----------------------------------------------
# Where the dev server proxies /api requests.
API_PROXY_TARGET=http://127.0.0.1:8000
